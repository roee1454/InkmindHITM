# Studio wall clock — appointment date math is process-local-timezone throughout.
# The boot check (src/lib/timezone.ts) self-heals a mismatch, but set it explicitly.
TZ=Asia/Jerusalem

# PocketBase (local dev: run `pnpm pb:dev`, see pocketbase/README.md)
POCKETBASE_URL=http://127.0.0.1:8090
VITE_POCKETBASE_URL=http://127.0.0.1:8090
PB_URL=http://127.0.0.1:8090
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# WhatsApp Cloud API — the only place these are configured, locally and in production
# (Render service Environment tab). Never entered through the app UI; see the read-only
# diagnostics in dashboard Settings → WhatsApp / onboarding's WhatsApp step.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Google Calendar sync (per staff member)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3101/api/google-calendar/oauth/callback

# Anthropic (WhatsApp AI agent) — one key per deployment, not per-studio
ANTHROPIC_API_KEY=

# Groq (WhatsApp voice notes speech-to-text transcription with Whisper)
GROQ_API_KEY=

# Shared secret PocketBase's appointments hook (pocketbase/pb_hooks/appointments.pb.js) sends
# back to this app's internal sync endpoint (src/routes/api/internal.appointment-sync.ts) —
# generate a random string. IMPORTANT: PocketBase's Go binary does not read this .env file the
# way the Node app does — you must export PB_HOOK_SECRET (and APP_INTERNAL_URL, below) in the
# actual environment that runs `./pocketbase serve`, and in Render's inkmind-crm-pocketbase
# service Environment tab in production.
PB_HOOK_SECRET=
# Base URL of this Node app from PocketBase's perspective. Defaults to http://127.0.0.1:3101
# if unset, which is correct for local dev only — must be set explicitly in production since
# the PocketBase and web services run as separate Render services.
APP_INTERNAL_URL=http://127.0.0.1:3101

# SMTP relay (pocketbase/pb_hooks/smtp-settings.pb.js applies these to PocketBase's mail settings
# at boot — password reset, email verification, etc.). Unset locally = mail disabled, dev boots
# fine without it. IMPORTANT: like PB_HOOK_SECRET above, PocketBase's Go binary reads these from
# its own process environment, not this .env file — export them wherever `./pocketbase serve`
# actually runs, and in Render's inkmind-crm-pocketbase service Environment tab in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=no-reply@roee.fyi
SMTP_FROM_NAME=Inkmind CRM
# Public URL of this app — used in the password-reset email link (unlike APP_INTERNAL_URL above,
# this one is opened by a human in a browser, so it must be a real, externally reachable URL).
APP_URL=http://localhost:3101